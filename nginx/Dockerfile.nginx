# ============================================================
# Dockerfile for Nginx serving React frontend + proxy to Flask
# ============================================================

FROM nginx:1.27-alpine

# Install openssl for cert generation (if needed)
RUN apk add --no-cache openssl

# Create cert directory
RUN mkdir -p /etc/nginx/certs

# Copy SSL certificates from dev environment
# (will be mounted as volume in docker-compose)
# Expected: localhost.crt and localhost.key in /etc/nginx/certs/

# Copy Nginx configuration
COPY nginx/nginx-react.conf /etc/nginx/conf.d/default.conf

# Create necessary directories for React files
RUN mkdir -p /app/dist

# Copy React built files (mounted as volume from frontend/dist)
# Volume will be: -v ./frontend/dist:/app/dist

# Health check — use /health endpoint (plain text, no body needed)
# --no-check-certificate: skip SSL verify for self-signed cert
# 127.0.0.1: avoid localhost resolving to IPv6 ::1 (nginx binds IPv4 only)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider --no-check-certificate https://127.0.0.1/health || exit 1

# Expose ports
EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
