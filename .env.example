# Instagram API Credentials
INSTAGRAM_APP_ID=your_app_id_here
INSTAGRAM_APP_SECRET=your_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:8000/auth/callback

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Database (opcional - já tem defaults no docker-compose)
# DATABASE_URL=postgresql://user:password@postgres:5432/recommendations_db

# Redis (opcional - já tem defaults no docker-compose)
# REDIS_URL=redis://redis:6379/0

# Kafka (opcional - já tem defaults no docker-compose)
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
