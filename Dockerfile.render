# 📦 Imagem base otimizada
FROM python:3.10-slim

# 🧱 Dependências do sistema para PostgreSQL + Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc curl unzip wget xdg-utils \
    fonts-liberation libnss3 libatk-bridge2.0-0 libxss1 \
    libasound2 libgtk-3-0 libx11-xcb1 libxcomposite1 libxdamage1 \
    libxrandr2 libgbm1 \
    ca-certificates gnupg libdrm2 libdbus-1-3 libxkbcommon0 libatspi2.0-0 \
    libxfixes3 libxtst6 libxext6 libxcb1 libx11-6 \
    libpangocairo-1.0-0 libpango-1.0-0 libharfbuzz0b \
    libfreetype6 libfontconfig1 libgdk-pixbuf-2.0-0 \
    libjpeg62-turbo libpng16-16 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 🧪 Instala Playwright e os browsers
RUN pip install --no-cache-dir playwright==1.54.0 \
 && playwright install

# 📁 Define o diretório da aplicação
WORKDIR /app

# 🗂️ Primeiro copia requirements para cache de layer
COPY services/site/requirements-prd.txt /app/requirements-prd.txt

# 📦 Instala dependências da aplicação (produção)
RUN pip install --no-cache-dir -r /app/requirements-prd.txt

# 🗂️ Agora copia todo o código do site (apenas de services/site/)
COPY services/site/*.py /app/
COPY services/site/models/ /app/models/
COPY services/site/routes/ /app/routes/
COPY services/site/services/ /app/services/
COPY services/site/scripts/ /app/scripts/
COPY services/site/templates/ /app/templates/
COPY services/site/static/ /app/static/
COPY services/site/staging/ /app/staging/
COPY services/site/uploads/ /app/uploads/
COPY services/site/config/ /app/config/

# 🔌 Porta exposta pela aplicação Flask
EXPOSE 5000

# 🚀 Comando padrão de inicialização
CMD ["python", "main.py"]
