# ====================================
# 🌍 Variáveis de Ambiente - Instagram
# ====================================

# OpenAI API (para agentes LangChain)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Instagram (para postagem automática)
INSTAGRAM_USERNAME=seu_usuario_instagram
INSTAGRAM_PASSWORD=sua_senha_instagram

# Redis (para cache e memória dos agentes)
REDIS_URL=redis://redis:6379

# ====================================
# 📝 Instruções
# ====================================
# 
# 1. Copie este arquivo para .env
# 2. Preencha as credenciais reais
# 3. Nunca comite o arquivo .env no git
#
# Para obter OpenAI API Key:
# https://platform.openai.com/api-keys
#
# Para Instagram:
# Use suas credenciais normais do Instagram
# (recomendado usar conta de teste/business)
